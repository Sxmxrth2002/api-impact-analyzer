{
  "name": "api-impact-analyser",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "prisma generate && tsc && npm run dashboard:build",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:tests": "tsc --project tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "dashboard:build": "tsc -p dashboard/tsconfig.json && vite build dashboard --outDir ../dist/dashboard --emptyOutDir",
    "dashboard": "node dist/server/dashboard.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@fastify/static": "^10.1.12",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "axios": "^1.20.0",
    "bullmq": "^6.7.5",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "octokit": "^5.0.5",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.5"
  }
}
